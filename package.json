{
  "name": "aetherion",
  "version": "1.0.0",
  "description": "Aetherion \u2014 Saitama-level Discord platform. Clean, powerful, production-ready.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node index.js",
    "dev": "tsx watch src/index.ts",
